<?xml version="1.0" encoding="UTF-8"?>
<!-- Software rendering only: compositing is disabled because there is no GPU,
     and title bars use a larger font for touch targets. -->
<channel name="xfwm4" version="1.0">
  <property name="general" type="empty">
    <property name="use_compositing" type="bool" value="false"/>
    <property name="title_font" type="string" value="Sans Bold 10"/>
    <property name="title_alignment" type="string" value="center"/>
    <property name="box_move" type="bool" value="false"/>
    <property name="box_resize" type="bool" value="true"/>
    <property name="double_click_distance" type="int" value="8"/>
  </property>
</channel>
